# ==== JIRA (Atlassian Cloud) ====
# Base de ton instance
JIRA_BASE_URL=https://bouyguestelecom.atlassian.net
# Ton email de connexion Atlassian
JIRA_EMAIL=prenom.nom@bouyguestelecom.fr
# Token API Atlassian : https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
# JQL utilisee pour extraire les tickets
JIRA_JQL=project = BACNSO ORDER BY created DESC

# ==== Microsoft Graph (Outlook + synthEses Copilot sur SharePoint/OneDrive) ====
# Optionnel : si non renseigne, le pipeline tourne en mode JIRA seul.
# App registration Entra ID (Azure AD) avec permissions DELEGUEES :
#   Mail.Read, Files.Read.All, Sites.Read.All, User.Read  (+ consentement admin selon tenant)
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
# Fenetre de recherche des mails / reunions (en jours)
LOOKBACK_DAYS=30
# Mots-cles pour filtrer mails/reunions pertinents (separes par des virgules)
GRAPH_KEYWORDS=BACNSO,NSO,automation,reseau

# ==== Sortie ====
OUTPUT_DIR=out
REPORT_TITLE=BACNSO - Point d'avancement
REPORT_AUTHOR=Belkacem KAID
